---
import { clinic } from '~/data/clinic';
import { visitSteps } from '~/data/visit-steps';
---

<section class="band band-sunk">
  <div class="wrap band-inner">
    <div class="band-head">
      <p class="eyebrow">Tu primera visita</p>
      <h2>Tres pasos, {clinic.firstVisit.durationLong}.</h2>
    </div>

    <ol class="pasos">
      {
        visitSteps.map((step, index) => (
          <li class="paso">
            <span class="paso-num" aria-hidden="true">
              {index + 1}
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .pasos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .paso-num {
    display: block;
    width: fit-content;
    min-width: 32px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--brass);
    color: var(--brass);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .paso h3 {
    margin-top: 16px;
    font-size: 17px;
  }

  .paso p {
    margin-block: 8px 0;
    color: var(--ink-soft);
    font-size: 16px;
  }

  @media (max-width: 860px) {
    .pasos {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
