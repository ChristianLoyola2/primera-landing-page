---
import { clinic } from '~/data/clinic';

const facts = [
  {
    term: 'Primera visita',
    lines: [`${clinic.firstVisit.duration} · ${clinic.firstVisit.note}`],
  },
  {
    term: 'Horario',
    lines: [clinic.hours.weekdays, clinic.hours.saturday],
  },
  {
    term: 'Dirección',
    lines: [clinic.address.street, clinic.address.district],
  },
  {
    term: 'Urgencias',
    lines: [clinic.urgency],
  },
];
---

<div class="ficha">
  <h2>La consulta</h2>
  <dl>
    {
      facts.map((fact) => (
        <div>
          <dt>{fact.term}</dt>
          <dd>
            {fact.lines.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .ficha {
    padding: 24px 24px 22px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .ficha h2 {
    color: var(--ink-soft);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  dl {
    display: grid;
    gap: 14px;
    margin: 16px 0 0;
  }

  dt {
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: 11.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  dd {
    margin: 3px 0 0;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
  }
</style>
