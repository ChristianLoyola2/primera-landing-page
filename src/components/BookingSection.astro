---
import BookingForm from '~/components/BookingForm.astro';
import { clinic } from '~/data/clinic';

const contact = [
  { value: clinic.phone.display, detail: clinic.hours.weekdays, href: clinic.phone.href },
  { value: clinic.email, detail: 'Respondemos el mismo día', href: `mailto:${clinic.email}` },
  { value: clinic.address.street, detail: clinic.address.transit },
];
---

<section class="section agendar" id="agendar">
  <div class="shell agendar-grid">
    <div class="agendar-side">
      <h2>Pide tu hora y te llamamos para confirmarla.</h2>
      <p>
        Déjanos tu preferencia de día y franja. Te llamamos dentro de las {
          clinic.responseWindow
        } siguientes para cerrar la hora exacta.
      </p>

      <div class="side-data">
        {
          contact.map((line) => (
            <div>
              <b>{line.href ? <a href={line.href}>{line.value}</a> : line.value}</b>
              <span>{line.detail}</span>
            </div>
          ))
        }
      </div>
    </div>

    <BookingForm />
  </div>
</section>

<style>
  .agendar {
    background: var(--surface-sunk);
  }

  .agendar-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    align-items: start;
    gap: 56px;
  }

  .agendar-side h2 {
    font-size: clamp(1.65rem, 3.4vw, 2.15rem);
  }

  .agendar-side > p {
    max-width: 40ch;
    margin-block: 16px 0;
    color: var(--ink-soft);
    font-size: 16.5px;
  }

  .side-data {
    display: grid;
    gap: 14px;
    margin-top: 32px;
    padding-top: 26px;
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.55;
  }

  .side-data b {
    display: block;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .side-data span {
    color: var(--ink-soft);
  }

  .side-data a {
    text-decoration: none;
  }

  .side-data a:hover {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .agendar-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
