---
import { clinic } from '~/data/clinic';

const columns = [
  { heading: clinic.name, detail: `${clinic.tagline} · ${clinic.address.district}` },
  { heading: clinic.address.street, detail: clinic.address.transit },
  { heading: clinic.hours.weekdays, detail: clinic.hours.saturday },
  { heading: clinic.phone.display, detail: clinic.email },
];
---

<footer class="pie">
  <div class="wrap pie-inner">
    {
      columns.map((column) => (
        <div class="pie-col">
          <b>{column.heading}</b>
          {column.detail}
        </div>
      ))
    }
  </div>
</footer>

<style>
  .pie {
    border-top: 1px solid var(--line);
  }

  .pie-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px 48px;
    padding-block: 40px 48px;
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: 14px;
  }

  .pie-col {
    display: grid;
    gap: 6px;
  }

  .pie-col b {
    display: block;
    color: var(--ink);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
</style>
