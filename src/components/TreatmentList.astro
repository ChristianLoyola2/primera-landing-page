---
import { treatments } from '~/data/treatments';
---

<section class="section" id="tratamientos">
  <div class="shell">
    <div class="section-head">
      <h2>Tratamientos y el tiempo que reservamos.</h2>
      <p>
        Cada hora se reserva completa para una sola persona. Si el tratamiento necesita más
        tiempo, te lo decimos antes de empezar.
      </p>
    </div>

    <ul class="lista">
      {
        treatments.map((treatment) => (
          <li>
            <div class="celda-nombre">
              <h3>{treatment.name}</h3>
              <p>{treatment.description}</p>
            </div>
            <div class="celda-dur">
              <b>{treatment.duration}</b>
              {treatment.qualifier && <span>{treatment.qualifier}</span>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lista {
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
  }

  .lista li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 10px 32px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }

  .lista li:first-child {
    border-top: 1px solid var(--line);
  }

  .celda-nombre h3 {
    font-size: 17.5px;
    font-weight: 500;
    letter-spacing: -0.012em;
  }

  .celda-nombre p {
    max-width: 56ch;
    margin: 8px 0 0;
    color: var(--ink-soft);
    font-size: 16px;
  }

  .celda-dur {
    text-align: right;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-variant-numeric: tabular-nums;
  }

  .celda-dur b {
    display: block;
    font-size: 16px;
    font-weight: 500;
  }

  .celda-dur span {
    display: block;
    margin-top: 3px;
    color: var(--ink-soft);
    font-size: 13px;
  }

  @media (max-width: 560px) {
    .lista li {
      grid-template-columns: 1fr;
    }

    .celda-dur {
      grid-row: 1;
      text-align: left;
    }

    .celda-dur b,
    .celda-dur span {
      display: inline;
      color: var(--ink-soft);
      font-size: 13.5px;
    }

    .celda-dur span::before {
      content: ', ';
    }
  }
</style>
