---
import ClinicFacts from '~/components/ClinicFacts.astro';
import ToothScan from '~/components/ToothScan.astro';
import { clinic } from '~/data/clinic';
---

<section class="wrap hero" id="inicio">
  <div>
    <p class="eyebrow">Odontología digital</p>
    <h1>Tu hora, con el diagnóstico hecho el mismo día.</h1>
    <p class="lead">
      Escaneamos, revisamos y te explicamos el plan en una sola visita de {
        clinic.firstVisit.durationLong
      }. Sin pastas de impresión y sin presupuestos que llegan tres días después.
    </p>

    <div class="hero-actions">
      <a class="btn" href="#agendar">Agendar hora</a>
      <a class="btn-quiet" href="#tratamientos">Ver tratamientos</a>
    </div>

    <p class="hero-note">
      Escáner intraoral 3D y radiografía panorámica digital de baja dosis, incluidos en la
      primera visita.
    </p>
  </div>

  <aside class="hero-aside">
    <ToothScan />
    <ClinicFacts />
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: start;
    gap: 64px;
    padding-block: 76px 68px;
  }

  h1 {
    margin-block: 20px 0;
    font-size: clamp(2.3rem, 5.2vw, 3.6rem);
    line-height: 1.06;
  }

  .lead {
    max-width: 34ch;
    margin-block: 22px 0;
    color: var(--ink-soft);
    font-size: 19px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 34px;
  }

  .hero-note {
    max-width: 40ch;
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: 13px;
  }

  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-block: 52px 48px;
    }
  }
</style>
