---
import ArchScan from '~/components/ArchScan.astro';
import { clinic } from '~/data/clinic';
---

<section class="panel" id="inicio">
  <div class="shell panel-grid">
    <div class="panel-say">
      <h1>Ves tu propia boca en la pantalla y sales con el plan escrito.</h1>
      <p class="lead">
        Escáner intraoral 3D y radiografía panorámica digital en la primera visita, que
        dura {clinic.firstVisit.durationLong}. Sin pasta de impresión y sin esperar tres
        días por el presupuesto.
      </p>

      <div class="panel-actions">
        <a class="btn" href="#agendar">Pedir hora</a>
        <a class="btn-line" href="#tratamientos">Ver tratamientos</a>
      </div>

      <p class="panel-note">Guardamos cupos de urgencia todos los días.</p>
    </div>

    <div class="panel-see">
      <ArchScan />
    </div>
  </div>
</section>

<style>
  .panel {
    background: var(--panel);
    color: var(--panel-ink);
  }

  .panel-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: 68px;
    padding-block: 84px 78px;
  }

  h1 {
    max-width: 17ch;
    font-size: clamp(2.25rem, 4.8vw, 3.3rem);
  }

  .lead {
    max-width: 44ch;
    margin-block: 26px 0;
    color: var(--panel-ink-soft);
    font-size: 18px;
    line-height: 1.68;
  }

  .panel-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin-top: 36px;
  }

  /* El botón y el enlace se repintan para la pantalla oscura. */
  .btn {
    border-color: var(--panel-accent);
    background: var(--panel-accent);
    color: #2a0c16;
  }

  .btn:hover {
    border-color: #f9a3b9;
    background: #f9a3b9;
  }

  .btn-line {
    border-color: var(--panel-line);
    color: var(--panel-ink);
  }

  .btn-line:hover {
    border-color: var(--panel-accent);
    color: var(--panel-accent);
  }

  .panel-note {
    margin-block: 30px 0;
    padding-top: 22px;
    border-top: 1px solid var(--panel-line);
    color: var(--panel-ink-soft);
    font-family: var(--font-ui);
    font-size: 14px;
  }

  .panel-see {
    padding: 26px 18px 22px;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-lg);
    background: var(--panel-soft);
  }

  @media (max-width: 900px) {
    .panel-grid {
      grid-template-columns: 1fr;
      gap: 46px;
      padding-block: 56px 52px;
    }

    h1 {
      max-width: 20ch;
    }
  }
</style>
