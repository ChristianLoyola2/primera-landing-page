# Clave de acceso de Web3Forms (https://web3forms.com).
# Solo se lee en el servidor, dentro de src/pages/api/booking.ts:
# nunca se incluye en el bundle que llega al navegador.
WEB3FORMS_ACCESS_KEY=

# URL pública del sitio. Se usa para la etiqueta canonical, las de Open Graph
# y los datos estructurados. En Vercel conviene dejarla fijada al dominio final.
SITE_URL=https://sonrisa-digital.vercel.app
